#define IDI_APPICON 101

IDI_APPICON ICON "assets\\slippery-taskbar.ico"
1 24 "app.manifest"

1 VERSIONINFO
 FILEVERSION 0,2,0,0
 PRODUCTVERSION 0,2,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "KoBruh\0"
            VALUE "FileDescription", "Slippery Taskbar\0"
            VALUE "FileVersion", "0.2.0\0"
            VALUE "InternalName", "SlipperyTaskbar\0"
            VALUE "OriginalFilename", "SlipperyTaskbar.exe\0"
            VALUE "ProductName", "Slippery Taskbar\0"
            VALUE "ProductVersion", "0.2.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
